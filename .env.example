# =============================================================================
# TTT WhatsApp Tax Bot — Environment Variables
# =============================================================================
# Copy this to .env and fill in the values. Never commit .env to git.

# --- Azure / Dynamics 365 ---
DYNAMICS_URL=https://yourorg.crm4.dynamics.com/
DYNAMICS_TENANT_ID=
DYNAMICS_CLIENT_ID=
DYNAMICS_CLIENT_SECRET=

# --- Microsoft Graph (tina-bot mailbox, email→WhatsApp relay) ---
# Separate Azure AD app registration from Dynamics. Mail.Read + Mail.Send are
# granted via Exchange RBAC for Applications scoped to the shared mailbox only,
# NOT via tenant-wide consent in Entra. See docs/graph-rbac-setup notes.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SHARED_MAILBOX=tina-bot@ttt-group.co.za
# Public HTTPS base URL where the bot is reachable; Graph POSTs notifications
# to {GRAPH_WEBHOOK_BASE_URL}/webhook/email. Locally use the ngrok domain;
# in prod use the Vercel deployment URL.
GRAPH_WEBHOOK_BASE_URL=
# Random opaque string echoed back by Graph on every notification. Generate
# with `openssl rand -hex 32`. Rotating it requires recreating the subscription.
GRAPH_WEBHOOK_CLIENT_STATE=

# Meta-approved template that asks the client for consent to relay an email
# over WhatsApp. Quick-reply button payloads must be `relay_yes` and `relay_no`.
WHATSAPP_RELAY_TEMPLATE_NAME=client_email_relay_consent
WHATSAPP_RELAY_TEMPLATE_LANG=en

# --- Meta WhatsApp Cloud API ---
# Leave empty for DRY-RUN mode (bot works normally but doesn't send real WhatsApp messages).
# Fill in to enable real WhatsApp delivery.
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
META_APP_SECRET=

# Pre-approved WhatsApp template that wraps the sign-up Flow (with web-form
# fallback button). Sent to unrecognized phone numbers as their first reply.
# Leave blank to fall back to the plain-link sign-up message.
WHATSAPP_SIGNUP_TEMPLATE_NAME=ttt_signup_flow
WHATSAPP_SIGNUP_TEMPLATE_LANG=en

# Letter of Engagement magic-link signing. LOE_SIGNING_SECRET must match the
# value the TTT onboarding Next.js app reads under the same name — if they
# diverge, every minted link fails with "Invalid signing link." 32+ random
# bytes recommended. Coordinate rotations with the TTT side.
# Leave blank to fall back to the generic sign-up URL in greetings.
LOE_SIGNING_SECRET=
LOE_ONBOARDING_HOST=ttt-tax.co.za

# --- AI / LLM (Anthropic Claude) ---
ANTHROPIC_API_KEY=

# --- OpenAI (embeddings only) ---
# Used to embed knowledge-base chunks and inbound queries for vector search.
# Model: text-embedding-3-small (1536 dims).
OPENAI_API_KEY=

# --- SharePoint (Tax Navigator KB source) ---
# Reuses the tara-bot Graph app reg's GRAPH_CLIENT_* credentials. Requires
# Sites.Selected granted in Entra AND a per-site permission grant on the
# specific site below — see docs/sharepoint-kb-setup notes.
SHAREPOINT_HOSTNAME=tttfinancialgroup.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/TaxNavigator
SHAREPOINT_KB_FOLDER=Tax Navigator

# SharePoint site where client documents land. The email→Power Automate flow
# writes here too, into per-client/per-upload-year subfolders under the
# DOCS_ROOT_FOLDER. The Graph app reg needs Sites.Selected on this site as
# well as the KB site — a separate per-site grant.
SHAREPOINT_DOCS_SITE_PATH=/sites/TTTProduction
SHAREPOINT_DOCS_ROOT_FOLDER=contact

# --- Mistral OCR ---
# Used to extract text from signed Letters of Engagement.
# Get a key from https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Bot config (TTT-specific) ---
SIGNUP_URL=https://app.ttt-tax.co.za/signup

# --- Cron ---
# Shared secret protecting /api/cron/* endpoints. Vercel Cron sends this as
# Authorization: Bearer <CRON_SECRET>. Leave blank in dev.
CRON_SECRET=

# --- Queue (BullMQ + Redis) ---
# Connection string for the inbound-message queue. Upstash works out of the
# box: copy the `rediss://default:<token>@<host>:<port>` URL from the Upstash
# console. The webhook ingester (server.ts) and the worker (worker.ts) both
# need this set and pointing at the same Redis.
REDIS_URL=
# Number of sharded queues / FIFO lanes. shard(phone) = hash(phone) % N
# routes every inbound from a given phone into the same lane → strict in-order
# processing per conversation. Bump for more parallelism (each shard runs at
# concurrency=1). Default 16. Both ingester and worker must agree on this number.
WORKER_NUM_SHARDS=1

# --- Tax-season FAQ feature flags ---
# Each of the 5 tax-season Q&A tools can be killed independently if data
# quality issues surface. Default is enabled — set to "false" to disable.
ENABLE_REFUND_ANSWERS=false
ENABLE_SUBMISSION_ANSWERS=false
ENABLE_REQUIRED_DOC_ANSWERS=false
ENABLE_RECEIVED_DOC_ANSWERS=false
ENABLE_AUDIT_ANSWERS=false

# --- WhatsApp doc-upload dual-write ---
# The tax-season year the bot defaults to when it can't infer one from the
# client's preseason records (e.g. they have 0 or >1 active preseason records).
# Plain integer — e.g. 2025 during the 2026 calendar year.
CURRENT_TAX_SEASON_YEAR=2025

# When true, the bot's dual-write also populates _riivo_preseasondoc_value on
# the riivo_taxsubmissionsdocuments row so the spec §3 status-reason recalc
# Power Automate flow fires. Leave OFF until the CRM admin has shipped the
# lookup field. The bot's row write succeeds either way — the link is purely
# additive.
ENABLE_PRESEASON_DOC_LINK=false

# --- Feedback prompt ---
# Controls when the L1 "Did that answer your question?" buttons are sent.
#   immediate (default) — sent right after the bot's answer (pre-PRD behavior)
#   idle                — schedule a 2.5-min delayed job; only fires if the
#                         client has gone silent (no inbound since the answer
#                         and no superseding case). Wrap-up "thanks" inbounds
#                         always close all open session cases silently with
#                         a single notification.
# Cutover plan: deploy with `immediate`, observe new code paths are dormant
# for 7 days, then flip to `idle`.
FEEDBACK_PROMPT_MODE=immediate

# --- Server ---
PORT=3001
